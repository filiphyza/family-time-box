rules_version = '2';

// Image files follow the same allowlist as firestore.rules (Firestore document access/allowlist).
service firebase.storage {
  match /b/{bucket}/o {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
          in firestore.get(/databases/(default)/documents/access/allowlist).data.emails;
    }

    match /photos/{photoId}/{file=**} {
      allow read, delete: if isFamily();
      // Images only, up to 60 MB each.
      allow create, update: if isFamily()
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
